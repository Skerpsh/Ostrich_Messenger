{
  "cli": {
    "version": ">= 24.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "quest": {
      "extends": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "github": {
      "extends": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "channel": "production"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
