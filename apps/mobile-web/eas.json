{
  "cli": {
    "version": ">= 24.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "quest": {
      "extends": "preview",
      "android": {
        "buildType": "apk",
        "applicationArchivePath": "android/app/build/outputs/apk/release/app-universal-release.apk"
      }
    },
    "github": {
      "extends": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "applicationArchivePath": "android/app/build/outputs/apk/release/app-universal-release.apk"
      },
      "buildArtifactPaths": [
        "android/app/build/outputs/apk/release/app-arm*-release.apk"
      ]
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
