{
  "expo": {
    "name": "Ostrich",
    "slug": "ostrich",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/baaf2efa-24d7-42fd-8309-d1a22459f144",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ostrich",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#111111",
    "ios": {
      "bundleIdentifier": "com.ostrich.messenger",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "com.ostrich.messenger",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"]
    },
    "web": {
      "name": "Ostrich Web",
      "shortName": "Ostrich",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#111111",
      "themeColor": "#111111"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ostrich uses your photos to set your profile picture and chat wallpapers.",
          "cameraPermission": "Ostrich uses the camera to scan QR codes: invites, contacts and safety codes.",
          "microphonePermission": "Ostrich uses the microphone for voice messages and calls."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ff8a3d"
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Ostrich uses the camera to scan QR codes: invites, contacts and safety codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Ostrich uses the microphone for voice messages and calls.",
          "enableBackgroundRecording": false
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Ostrich uses the camera to scan QR codes: invites, contacts and safety codes.",
          "microphonePermission": "Ostrich uses the microphone for voice messages and calls."
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "AccentOrange",
            "ios": "./assets/images/app-icons/icon-orange.png",
            "android": {
              "foregroundImage": "./assets/images/android-icon-foreground.png",
              "backgroundColor": "#b84e08"
            }
          },
          {
            "name": "AccentRed",
            "ios": "./assets/images/app-icons/icon-red.png",
            "android": {
              "foregroundImage": "./assets/images/android-icon-foreground.png",
              "backgroundColor": "#c0262d"
            }
          },
          {
            "name": "AccentPink",
            "ios": "./assets/images/app-icons/icon-pink.png",
            "android": {
              "foregroundImage": "./assets/images/android-icon-foreground.png",
              "backgroundColor": "#b3206a"
            }
          },
          {
            "name": "AccentPurple",
            "ios": "./assets/images/app-icons/icon-purple.png",
            "android": {
              "foregroundImage": "./assets/images/android-icon-foreground.png",
              "backgroundColor": "#6a3cd0"
            }
          },
          {
            "name": "AccentBlue",
            "ios": "./assets/images/app-icons/icon-blue.png",
            "android": {
              "foregroundImage": "./assets/images/android-icon-foreground.png",
              "backgroundColor": "#1c5fc4"
            }
          },
          {
            "name": "AccentTeal",
            "ios": "./assets/images/app-icons/icon-teal.png",
            "android": {
              "foregroundImage": "./assets/images/android-icon-foreground.png",
              "backgroundColor": "#0a756a"
            }
          },
          {
            "name": "AccentGreen",
            "ios": "./assets/images/app-icons/icon-green.png",
            "android": {
              "foregroundImage": "./assets/images/android-icon-foreground.png",
              "backgroundColor": "#2b7a30"
            }
          },
          {
            "name": "AccentGold",
            "ios": "./assets/images/app-icons/icon-gold.png",
            "android": {
              "foregroundImage": "./assets/images/android-icon-foreground.png",
              "backgroundColor": "#856400"
            }
          }
        ]
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "baaf2efa-24d7-42fd-8309-d1a22459f144"
      }
    }
  }
}
