# The monitoring bot (apps/server/src/monitor/): reports to Telegram every 15
# minutes and alerts when something breaks. See "Monitoring bot" in
# deploy/README.md.
[Unit]
Description=Ostrich monitoring bot
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
WorkingDirectory=/opt/ostrich/apps/server
EnvironmentFile=/opt/ostrich/apps/server/.env
Environment=NODE_ENV=production
# Node from nvm (/root/.nvm) if installed there, else from PATH.
ExecStart=/bin/bash -c '[ -s /root/.nvm/nvm.sh ] && . /root/.nvm/nvm.sh; exec node dist/monitor/main.js'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
